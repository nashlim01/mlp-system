# Supabase: Project Settings → Connect → Session pooler (keep sslmode=require)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key, server-side only>

# AI reading of transfer slips (Receipts page)
ANTHROPIC_API_KEY=
COMPANY_ACCOUNT_LAST4=          # last 4 digits of the account(s) tenants pay into, comma-separated
RECEIPT_STORAGE=                # 'local' keeps slips in raw/receipts/ (local demo); empty = Supabase Storage

SEB_LOGIN_URL=
SEB_USERNAME=
SEB_PASSWORD=

# Deployment only
TUNNEL_TOKEN=
